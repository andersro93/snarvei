{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snarvei",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker is reachable only through its custom domain: no workers.dev
  // subdomain and no version preview URLs (they would be a second, unbranded
  // auth origin). Domains are declared here so infrastructure stays in code.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "snarvei.ros-nett.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/l/*", "/images/profile/*", "/openapi.json", "/scalar"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snarvei",
      "database_id": "a506e6e7-0da6-49fe-9ee5-bd57a5999f21",
      "migrations_dir": "./src/worker/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PROFILE_IMAGES",
      "bucket_name": "snarvei-profile-images",
    },
  ],
  "vars": {
    "APP_URL": "https://snarvei.ros-nett.com",
    "APP_NAME": "Snarvei",
    "NODE_ENV": "production",
  },
  // Edge rate limiting for the public redirect and auth endpoints (per client IP).
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "env": {
    "dev": {
      "name": "snarvei-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "snarvei-dev.ros-nett.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "snarvei-dev",
          "database_id": "5de8c0b4-6496-4818-adfa-3599f17c3a9b",
          "migrations_dir": "./src/worker/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PROFILE_IMAGES",
          "bucket_name": "snarvei-dev-profile-images",
        },
      ],
      "vars": {
        "APP_URL": "https://snarvei-dev.ros-nett.com",
        "APP_NAME": "Snarvei - DEV",
        "NODE_ENV": "production",
      },
      "ratelimits": [
        {
          "name": "RATE_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
    },
  },
}
