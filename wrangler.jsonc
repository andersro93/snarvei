{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snarvei",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker is reachable only through its custom domain: no workers.dev
  // subdomain and no version preview URLs (they would be a second, unbranded
  // auth origin). The custom domains themselves are attached in the Cloudflare
  // dashboard. To manage them from code add
  //   "routes": [{ "pattern": "snarvei.ros-nett.com", "custom_domain": true }]
  // (and the dev equivalent) AND grant the deploy API token the zone-level
  // permissions "Workers Routes: Edit" and "DNS: Edit" — without them
  // `wrangler deploy` fails with "Authentication error [code: 10000]".
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/l/*", "/images/profile/*", "/openapi.json", "/scalar"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snarvei",
      "database_id": "a506e6e7-0da6-49fe-9ee5-bd57a5999f21",
      "migrations_dir": "./src/worker/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PROFILE_IMAGES",
      "bucket_name": "snarvei-profile-images",
    },
  ],
  "vars": {
    "APP_URL": "https://snarvei.ros-nett.com",
    "APP_NAME": "Snarvei",
    "NODE_ENV": "production",
    "EMAIL_FROM": "Snarvei <no-reply@ros-nett.com>",
  },
  // Transactional email (invitations, verification, password reset) through
  // Cloudflare Email Service. The sender domain must be onboarded under
  // Compute -> Email Service -> Email Sending (Workers Paid). Locally the
  // binding is simulated: messages are logged and written to miniflare's tmp dir.
  "send_email": [{ "name": "EMAIL" }],
  // Edge rate limiting for the public redirect and auth endpoints (per client IP).
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "env": {
    "dev": {
      "name": "snarvei-dev",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "snarvei-dev",
          "database_id": "5de8c0b4-6496-4818-adfa-3599f17c3a9b",
          "migrations_dir": "./src/worker/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PROFILE_IMAGES",
          "bucket_name": "snarvei-dev-profile-images",
        },
      ],
      "vars": {
        "APP_URL": "https://snarvei-dev.ros-nett.com",
        "APP_NAME": "Snarvei - DEV",
        "NODE_ENV": "production",
        "EMAIL_FROM": "Snarvei DEV <no-reply@ros-nett.com>",
      },
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        {
          "name": "RATE_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
    },
  },
}
