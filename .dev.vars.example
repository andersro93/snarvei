# At least 32 characters; generate with: openssl rand -hex 32
AUTH_SECRET=change-me-in-local-dev-change-me-in-local-dev
# Must match the origin you open in the browser (pnpm dev serves http://localhost:5173).
APP_URL=http://localhost:5173
# Optional: dedicated secret for hashing visitor IPs (defaults to AUTH_SECRET).
# Set it in production so rotating AUTH_SECRET does not reset visitor analytics.
# IP_HASH_PEPPER=change-me-too
# Transactional email (invitations, verification, password reset) goes through
# the Cloudflare Email Service binding (EMAIL in wrangler.jsonc) + EMAIL_FROM.
# Locally the binding is simulated (messages are logged/written to a temp dir);
# override the sender here if needed:
# EMAIL_FROM=Snarvei <no-reply@your-domain.example>
# Local development only: log full email bodies (including links) instead.
EMAIL_DEV_LOG=true
